<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Number Hunter Arcade Edition</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Rajdhani:wght@500;700&display=swap" rel="stylesheet">
    
    <style>
        body {
            font-family: 'Rajdhani', sans-serif;
            background-color: #070a12;
            color: #f3f4f6;
            overflow-x: hidden;
            touch-action: manipulation;
            user-select: none;
            -webkit-user-select: none;
        }

        .font-arcade {
            font-family: 'Orbitron', sans-serif;
        }

        .neon-border-cyan {
            box-shadow: 0 0 20px rgba(6, 182, 212, 0.4), inset 0 0 15px rgba(6, 182, 212, 0.2);
            border: 2px solid #06b6d4;
        }

        .neon-border-purple {
            box-shadow: 0 0 20px rgba(168, 85, 247, 0.4), inset 0 0 15px rgba(168, 85, 247, 0.2);
            border: 2px solid #a855f7;
        }

        .neon-text-cyan {
            text-shadow: 0 0 10px rgba(6, 182, 212, 0.8), 0 0 20px rgba(6, 182, 212, 0.5);
        }

        .neon-text-pink {
            text-shadow: 0 0 10px rgba(236, 72, 153, 0.8), 0 0 20px rgba(236, 72, 153, 0.5);
        }

        .glass-panel {
            background: rgba(15, 23, 42, 0.85);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.12);
        }

        .grid-tile {
            transition: transform 0.15s cubic-bezier(0.175, 0.885, 0.32, 1.275), background-color 0.2s, box-shadow 0.2s;
        }

        .grid-tile:active {
            transform: scale(0.92);
        }

        @keyframes floatSlow {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-8px); }
        }

        .animate-float {
            animation: floatSlow 4s infinite ease-in-out;
        }

        @keyframes pulseGlow {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.85; transform: scale(1.03); }
        }

        .animate-pulse-glow {
            animation: pulseGlow 2s infinite ease-in-out;
        }

        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            20%, 60% { transform: translateX(-6px); }
            40%, 80% { transform: translateX(6px); }
        }

        .animate-shake {
            animation: shake 0.3s ease-in-out;
        }

        ::-webkit-scrollbar {
            width: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #0b0f19;
        }
        ::-webkit-scrollbar-thumb {
            background: #06b6d4;
            border-radius: 3px;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between items-center relative overflow-y-auto">

    <!-- Background Canvas for Interactive Particles -->
    <canvas id="bgCanvas" class="fixed inset-0 pointer-events-none z-0"></canvas>

    <header class="w-full max-w-4xl px-4 py-3 flex justify-between items-center z-10 glass-panel mt-2 rounded-2xl mx-auto shadow-2xl">
        <div class="flex items-center gap-3 cursor-pointer" onclick="game.showHome()">
            <!-- SVG Mascot Logo -->
            <div class="w-11 h-11 rounded-xl bg-gradient-to-tr from-cyan-500 via-indigo-600 to-pink-500 p-0.5 shadow-lg shadow-cyan-500/30">
                <div class="w-full h-full bg-gray-950 rounded-[10px] flex items-center justify-center">
                    <svg class="w-7 h-7" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 20C12 15.5817 15.5817 12 20 12H44C48.4183 12 52 15.5817 52 20V44C52 48.4183 48.4183 52 44 52H20C15.5817 52 12 48.4183 12 44V20Z" fill="#0F172A" stroke="#06B6D4" stroke-width="3"/>
                        <circle cx="24" cy="26" r="5" fill="#06B6D4"/>
                        <circle cx="40" cy="26" r="5" fill="#EC4899"/>
                        <path d="M20 38H44" stroke="#A855F7" stroke-width="4" stroke-linecap="round"/>
                        <path d="M28 38V44M36 38V44" stroke="#A855F7" stroke-width="3"/>
                    </svg>
                </div>
            </div>
            <div>
                <h1 class="font-arcade text-lg md:text-xl font-bold tracking-wider text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-purple-400 to-pink-500">
                    NUMBER HUNTER
                </h1>
                <p class="text-[10px] text-cyan-300 tracking-widest hidden sm:block uppercase">CYBER ARCADE EDITION</p>
            </div>
        </div>

        <div class="flex items-center gap-2 md:gap-3">
            <button id="audioBtn" onclick="game.toggleAudio()" class="w-10 h-10 rounded-xl bg-gray-900/90 hover:bg-gray-800 text-cyan-400 border border-cyan-800 flex items-center justify-center transition shadow-md" title="Efek Suara">
                <i class="fas fa-volume-up text-lg"></i>
            </button>
            <button id="musicBtn" onclick="game.toggleMusic()" class="w-10 h-10 rounded-xl bg-gray-900/90 hover:bg-gray-800 text-pink-400 border border-pink-800 flex items-center justify-center transition shadow-md" title="Musik Latar">
                <i class="fas fa-music text-lg"></i>
            </button>
            <button onclick="game.showModal('howToPlay')" class="w-10 h-10 rounded-xl bg-gray-900/90 hover:bg-gray-800 text-purple-400 border border-purple-800 flex items-center justify-center transition shadow-md">
                <i class="fas fa-circle-question text-lg"></i>
            </button>
            <button onclick="game.showModal('achievements')" class="w-10 h-10 rounded-xl bg-gray-900/90 hover:bg-gray-800 text-yellow-400 border border-yellow-800 flex items-center justify-center transition shadow-md">
                <i class="fas fa-trophy text-lg"></i>
            </button>
        </div>
    </header>

    <main class="w-full max-w-4xl px-3 my-auto py-4 z-10 flex flex-col items-center justify-center">

        <!-- SCREEN 1: HOME MENU WITH SVG ILLUSTRATIONS -->
        <section id="screenHome" class="w-full flex flex-col items-center text-center space-y-6">
            
            <!-- Graphic Hero Banner (SVG Game Machine Artwork) -->
            <div class="w-full max-w-md relative flex justify-center items-center my-1 animate-float">
                <svg class="w-full max-w-[320px] h-auto drop-shadow-[0_0_25px_rgba(6,182,212,0.4)]" viewBox="0 0 400 220" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <!-- Cabinet Outer -->
                    <rect x="70" y="20" width="260" height="180" rx="20" fill="#0F172A" stroke="#06B6D4" stroke-width="4"/>
                    <!-- Screen Frame -->
                    <rect x="90" y="35" width="220" height="110" rx="12" fill="#030712" stroke="#A855F7" stroke-width="3"/>
                    <!-- Screen Grid Pattern -->
                    <path d="M100 60H300M100 85H300M100 110H300M140 40V140M190 40V140M240 40V140M280 40V140" stroke="#1E293B" stroke-width="1.5"/>
                    <!-- Dynamic Numbers Floating in Screen Art -->
                    <text x="110" y="75" font-family="Orbitron" font-weight="900" font-size="22" fill="#06B6D4">7</text>
                    <text x="160" y="105" font-family="Orbitron" font-weight="900" font-size="28" fill="#EC4899">42</text>
                    <text x="215" y="70" font-family="Orbitron" font-weight="900" font-size="20" fill="#EAB308">99</text>
                    <text x="255" y="125" font-family="Orbitron" font-weight="900" font-size="24" fill="#10B981">13</text>
                    <circle cx="178" cy="98" r="22" stroke="#EC4899" stroke-width="2.5" stroke-dasharray="4 4"/>
                    <!-- Control Panel Stand -->
                    <rect x="100" y="155" width="200" height="30" rx="6" fill="#1E293B" stroke="#06B6D4" stroke-width="2"/>
                    <!-- Arcade Joystick & Buttons -->
                    <circle cx="130" cy="170" r="8" fill="#EF4444"/>
                    <path d="M130 170L125 180" stroke="#9CA3AF" stroke-width="3"/>
                    <circle cx="210" cy="170" r="5" fill="#06B6D4"/>
                    <circle cx="230" cy="168" r="5" fill="#A855F7"/>
                    <circle cx="250" cy="170" r="5" fill="#EC4899"/>
                </svg>
            </div>

            <div class="space-y-2 max-w-lg">
                <span class="px-3 py-1 text-xs font-semibold uppercase tracking-widest bg-cyan-950/80 text-cyan-400 border border-cyan-700 rounded-full inline-block shadow-md">
                    ⚡ Fast Reflex & Math Challenge
                </span>
                <h2 class="font-arcade text-3xl md:text-5xl font-black text-white leading-tight">
                    HUNT THE <span class="neon-text-pink">NUMBERS</span>
                </h2>
                <p class="text-gray-400 text-sm md:text-base">
                    Uji kecepatan mata, refleks, dan kecerdasan otakmu! Pilih mode permainan dan cetak rekor tertinggi.
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 w-full max-w-3xl">
                <!-- Mode 1 Card -->
                <div onclick="game.startGame('sequence')" class="glass-panel p-5 rounded-2xl border border-cyan-500/40 hover:border-cyan-400 cursor-pointer transform hover:-translate-y-1.5 transition duration-200 group relative overflow-hidden flex flex-col justify-between">
                    <div>
                        <div class="w-full h-24 mb-3 rounded-xl bg-slate-900/90 border border-cyan-900 flex items-center justify-center p-2 group-hover:border-cyan-500 transition">
                            <!-- SVG Graphic 1 -->
                            <svg class="w-20 h-20" viewBox="0 0 100 100" fill="none">
                                <rect x="10" y="10" width="35" height="35" rx="8" fill="#082F49" stroke="#06B6D4" stroke-width="2"/>
                                <text x="22" y="34" font-family="Orbitron" font-weight="700" font-size="18" fill="#38BDF8">1</text>
                                <rect x="55" y="10" width="35" height="35" rx="8" fill="#082F49" stroke="#06B6D4" stroke-width="2"/>
                                <text x="66" y="34" font-family="Orbitron" font-weight="700" font-size="18" fill="#38BDF8">2</text>
                                <rect x="10" y="55" width="35" height="35" rx="8" fill="#082F49" stroke="#06B6D4" stroke-width="2"/>
                                <text x="21" y="79" font-family="Orbitron" font-weight="700" font-size="18" fill="#38BDF8">3</text>
                                <rect x="55" y="55" width="35" height="35" rx="8" fill="#0284C7" stroke="#38BDF8" stroke-width="3"/>
                                <text x="65" y="79" font-family="Orbitron" font-weight="900" font-size="20" fill="#FFFFFF">4</text>
                                <path d="M47 28H53M30 47V53M53 73H47" stroke="#38BDF8" stroke-width="2" stroke-linecap="round"/>
                            </svg>
                        </div>
                        <h3 class="font-arcade text-lg font-bold text-white mb-1 group-hover:text-cyan-400 transition">Sequence Hunter</h3>
                        <p class="text-xs text-gray-400">Tekan angka secara berurutan mulai dari 1 hingga habis secepat mungkin!</p>
                    </div>
                </div>

                <!-- Mode 2 Card -->
                <div onclick="game.startGame('target')" class="glass-panel p-5 rounded-2xl border border-purple-500/40 hover:border-purple-400 cursor-pointer transform hover:-translate-y-1.5 transition duration-200 group relative overflow-hidden flex flex-col justify-between">
                    <div>
                        <div class="w-full h-24 mb-3 rounded-xl bg-slate-900/90 border border-purple-900 flex items-center justify-center p-2 group-hover:border-purple-500 transition">
                            <!-- SVG Graphic 2 -->
                            <svg class="w-20 h-20" viewBox="0 0 100 100" fill="none">
                                <circle cx="50" cy="50" r="38" fill="#2E1065" stroke="#A855F7" stroke-width="2"/>
                                <circle cx="50" cy="50" r="26" stroke="#C084FC" stroke-width="2" stroke-dasharray="4 4"/>
                                <circle cx="50" cy="50" r="14" fill="#7E22CE" stroke="#F0ABFC" stroke-width="2"/>
                                <path d="M50 8V22M50 78V92M8 50H22M78 50H92" stroke="#A855F7" stroke-width="3" stroke-linecap="round"/>
                                <text x="38" y="56" font-family="Orbitron" font-weight="900" font-size="16" fill="#FFFFFF">88</text>
                            </svg>
                        </div>
                        <h3 class="font-arcade text-lg font-bold text-white mb-1 group-hover:text-purple-400 transition">Speed Target</h3>
                        <p class="text-xs text-gray-400">Temukan angka target yang diperintahkan sebelum waktu habis!</p>
                    </div>
                </div>

                <!-- Mode 3 Card -->
                <div onclick="game.startGame('math')" class="glass-panel p-5 rounded-2xl border border-pink-500/40 hover:border-pink-400 cursor-pointer transform hover:-translate-y-1.5 transition duration-200 group relative overflow-hidden flex flex-col justify-between">
                    <div>
                        <div class="w-full h-24 mb-3 rounded-xl bg-slate-900/90 border border-pink-900 flex items-center justify-center p-2 group-hover:border-pink-500 transition">
                            <!-- SVG Graphic 3 -->
                            <svg class="w-20 h-20" viewBox="0 0 100 100" fill="none">
                                <rect x="15" y="15" width="70" height="70" rx="12" fill="#831843" stroke="#EC4899" stroke-width="2"/>
                                <rect x="25" y="25" width="50" height="22" rx="6" fill="#500724" stroke="#F472B6" stroke-width="1.5"/>
                                <text x="30" y="41" font-family="Orbitron" font-weight="700" font-size="13" fill="#F472B6">7 x 8 = ?</text>
                                <circle cx="35" cy="62" r="7" fill="#BE185D"/>
                                <text x="32" y="66" font-weight="bold" font-size="11" fill="#FFF">+</text>
                                <circle cx="65" cy="62" r="7" fill="#BE185D"/>
                                <text x="62" y="65" font-weight="bold" font-size="12" fill="#FFF">=</text>
                                <circle cx="50" cy="76" r="7" fill="#DB2777"/>
                                <text x="45" y="80" font-weight="bold" font-size="11" fill="#FFF">56</text>
                            </svg>
                        </div>
                        <h3 class="font-arcade text-lg font-bold text-white mb-1 group-hover:text-pink-400 transition">Math Hunter</h3>
                        <p class="text-xs text-gray-400">Selesaikan soal matematika cepat dan tekan jawaban yang tepat pada papan!</p>
                    </div>
                </div>
            </div>

            <!-- Stats Overview Card -->
            <div class="glass-panel px-6 py-4 rounded-xl flex items-center justify-around w-full max-w-lg border border-gray-800 shadow-xl">
                <div class="text-center">
                    <p class="text-[10px] text-gray-400 font-semibold uppercase tracking-wider">Total Game</p>
                    <p id="statTotalGames" class="font-arcade text-xl text-cyan-400 font-bold">0</p>
                </div>
                <div class="h-8 w-px bg-gray-800"></div>
                <div class="text-center">
                    <p class="text-[10px] text-gray-400 font-semibold uppercase tracking-wider">High Score</p>
                    <p id="statHighScore" class="font-arcade text-xl text-yellow-400 font-bold">0</p>
                </div>
                <div class="h-8 w-px bg-gray-800"></div>
                <div class="text-center">
                    <p class="text-[10px] text-gray-400 font-semibold uppercase tracking-wider">Best Combo</p>
                    <p id="statBestCombo" class="font-arcade text-xl text-pink-400 font-bold">0x</p>
                </div>
            </div>
        </section>

        <section id="screenGame" class="w-full max-w-2xl hidden flex-col items-center space-y-4">
            
            <!-- HUD Top Header -->
            <div class="w-full glass-panel p-4 rounded-2xl flex items-center justify-between shadow-xl">
                <!-- Score & Combo -->
                <div>
                    <div class="text-[10px] text-gray-400 font-semibold uppercase tracking-wider">SKOR</div>
                    <div id="gameScore" class="font-arcade text-2xl md:text-3xl font-bold text-yellow-400">0000</div>
                </div>

                <!-- Target Objective Display -->
                <div class="text-center px-5 py-1.5 bg-gray-950/90 rounded-xl border border-cyan-800 min-w-[140px] shadow-inner">
                    <div id="objectiveLabel" class="text-[10px] text-cyan-400 font-bold uppercase tracking-widest">CARI ANGKA</div>
                    <div id="objectiveDisplay" class="font-arcade text-2xl md:text-3xl font-black text-cyan-300 neon-text-cyan">1</div>
                </div>

                <!-- Timer Display -->
                <div class="text-right">
                    <div class="text-[10px] text-gray-400 font-semibold uppercase tracking-wider">WAKTU</div>
                    <div id="gameTimer" class="font-arcade text-2xl md:text-3xl font-bold text-pink-500">30.0s</div>
                </div>
            </div>

            <!-- Time Progress Bar -->
            <div class="w-full bg-gray-900 rounded-full h-3 overflow-hidden border border-gray-800 p-0.5">
                <div id="timerBar" class="bg-gradient-to-r from-pink-500 via-purple-500 to-cyan-400 h-full rounded-full w-full transition-all duration-100"></div>
            </div>

            <!-- Combo Badge & Streak indicator -->
            <div class="flex items-center justify-between w-full px-2">
                <div class="flex items-center gap-2">
                    <span id="comboBadge" class="hidden px-3 py-1 text-xs font-arcade font-bold bg-pink-950 text-pink-400 border border-pink-600 rounded-lg animate-bounce">
                        🔥 COMBO x<span id="comboValue">1</span>!
                    </span>
                </div>
                <div class="text-xs font-semibold text-gray-400">
                    Mode: <span id="currentModeLabel" class="text-cyan-400 uppercase font-bold">Sequence</span>
                </div>
            </div>

            <!-- Game Grid Board -->
            <div id="gridBoard" class="grid grid-cols-5 gap-2.5 sm:gap-3 w-full p-3 glass-panel rounded-2xl neon-border-cyan bg-slate-950/90 aspect-square max-w-[460px] mx-auto shadow-2xl">
                <!-- Dynamically Generated Tiles -->
            </div>

            <div class="w-full glass-panel p-2.5 rounded-xl flex items-center justify-around gap-2">
                <!-- PowerUp 1: Freeze -->
                <button id="pwrFreeze" onclick="game.usePowerUp('freeze')" class="flex-1 py-2 px-3 rounded-xl bg-gray-900/90 hover:bg-cyan-950 border border-cyan-800/60 flex items-center justify-center gap-2 text-cyan-300 disabled:opacity-30 disabled:pointer-events-none transition shadow-md">
                    <svg class="w-4 h-4 fill-current text-cyan-400" viewBox="0 0 24 24">
