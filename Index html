    <!-- Bottom Audio Control Bar & Music Player -->
    <footer class="w-full max-w-4xl px-4 py-3 mb-2 z-10 bg-cyber-card/90 border border-cyan-500/20 rounded-2xl backdrop-blur-md flex flex-wrap items-center justify-between gap-3 shadow-xl">
        
        <!-- Track Details -->
        <div class="flex items-center gap-3">
            <button id="btnPlayMusic" class="w-10 h-10 rounded-full bg-gradient-to-tr from-purple-600 to-pink-600 flex items-center justify-center text-white hover:scale-105 transition-all shadow-lg shadow-purple-500/30">
                <i class="fas fa-play" id="playIcon"></i>
            </button>
            <div>
                <div class="flex items-center gap-2">
                    <span id="trackTitle" class="font-orbitron font-bold text-xs text-cyan-300 tracking-wide">Cyber Pulse Synthesizer</span>
                    <span class="text-[10px] bg-pink-500/20 text-pink-300 px-1.5 py-0.5 rounded font-mono">SYNTH BGM</span>
                </div>
                <p id="trackArtist" class="text-[11px] text-gray-400">Web Audio Chiptune Engine</p>
            </div>
        </div>

        <!-- Audio Visualizer Canvas -->
        <div class="hidden sm:block flex-1 max-w-[200px] h-8 bg-black/50 border border-cyan-500/20 rounded-lg overflow-hidden px-1">
            <canvas id="visualizerCanvas" class="w-full h-full"></canvas>
        </div>

        <!-- Music Controls -->
        <div class="flex items-center gap-3">
            <!-- Track Switcher -->
            <button id="btnNextTrack" class="px-2.5 py-1 rounded bg-gray-800 border border-gray-700 text-xs text-gray-300 hover:text-cyan-400 flex items-center gap-1">
                <i class="fas fa-step-forward text-[10px]"></i>
                <span class="font-mono text-[11px]">Ganti Lagu</span>
            </button>
            
            <!-- Mute SFX Toggle -->
            <button id="btnToggleSFX" class="w-8 h-8 rounded-lg bg-gray-800/80 border border-gray-700 text-cyan-400 hover:bg-gray-700 flex items-center justify-center text-xs">
                <i class="fas fa-volume-up" id="sfxIcon"></i>
            </button>
        </div>
    </footer>

    <script>
        // ==========================================
        // WEB AUDIO API SYNTHESIZER (NO EXTERNAL FILES)
        // ==========================================
        class AudioEngine {
            constructor() {
                this.ctx = null;
                this.isPlaying = false;
                this.sfxMuted = false;
                this.currentTrack = 0;
                this.timerId = null;
                this.noteStep = 0;
                this.analyser = null;

                // Track Presets (Frequensi Melodi & Bass Loop)
                this.tracks = [
                    {
                        name: "Cyber Pulse Synth",
                        tempo: 140,
                        bass: [110, 110, 130.81, 110, 146.83, 130.81, 110, 98.00],
                        lead: [220, 261.63, 329.63, 392.00, 329.63, 261.63, 293.66, 329.63]
                    },
                    {
                        name: "8-Bit Retro Hunter",
                        tempo: 160,
                        bass: [130.81, 130.81, 164.81, 130.81, 174.61, 164.81, 130.81, 146.83],
                        lead: [329.63, 392.00, 440.00, 523.25, 440.00, 392.00, 349.23, 329.63]
                    },
                    {
                        name: "Neon Night Drive",
                        tempo: 120,
                        bass: [98.00, 98.00, 110.00, 98.00, 123.47, 110.00, 98.00, 87.31],
                        lead: [196.00, 246.94, 293.66, 329.63, 293.66, 246.94, 220.00, 196.00]
                    }
                ];
            }

            init() {
                if (!this.ctx) {
                    const AudioContext = window.AudioContext || window.webkitAudioContext;
                    this.ctx = new AudioContext();
                    this.analyser = this.ctx.createAnalyser();
                    this.analyser.fftSize = 32;
                }
                if (this.ctx.state === 'suspended') {
                    this.ctx.resume();
                }
            }

            playMusic() {
                this.init();
                if (this.isPlaying) return;
                this.isPlaying = true;
                const track = this.tracks[this.currentTrack];
                const interval = (60 / track.tempo / 2) * 1000;

                this.timerId = setInterval(() => {
                    this.playSynthStep();
                }, interval);
            }

            stopMusic() {
                this.isPlaying = false;
                if (this.timerId) clearInterval(this.timerId);
            }

            toggleMusic() {
                if (this.isPlaying) {
                    this.stopMusic();
                } else {
                    this.playMusic();
                }
                return this.isPlaying;
            }

            nextTrack() {
                const wasPlaying = this.isPlaying;
                this.stopMusic();
                this.currentTrack = (this.currentTrack + 1) % this.tracks.length;
                if (wasPlaying) {
                    this.playMusic();
                }
                return this.tracks[this.currentTrack].name;
            }

            playSynthStep() {
                if (!this.ctx || !this.isPlaying) return;

                const track = this.tracks[this.currentTrack];
                const t = this.ctx.currentTime;

                // Bass Synthesizer
                const bassOsc = this.ctx.createOscillator();
                const bassGain = this.ctx.createGain();
                bassOsc.type = 'sawtooth';
                bassOsc.frequency.setValueAtTime(track.bass[this.noteStep % track.bass.length], t);
                bassGain.gain.setValueAtTime(0.04, t);
                bassGain.gain.exponentialRampToValueAtTime(0.001, t + 0.18);
                
                bassOsc.connect(bassGain);
                bassGain.connect(this.analyser);
                this.analyser.connect(this.ctx.destination);
                
                bassOsc.start(t);
                bassOsc.stop(t + 0.2);

                // Lead Arpeggio Melody
                if (this.noteStep % 2 === 0) {
                    const leadOsc = this.ctx.createOscillator();
                    const leadGain = this.ctx.createGain();
                    leadOsc.type = 'square';
                    leadOsc.frequency.setValueAtTime(track.lead[(this.noteStep / 2) % track.lead.length], t);
                    leadGain.gain.setValueAtTime(0.02, t);
                    leadGain.gain.exponentialRampToValueAtTime(0.001, t + 0.15);

                    leadOsc.connect(leadGain);
                    leadGain.connect(this.analyser);
                    
                    leadOsc.start(t);
                    leadOsc.stop(t + 0.18);
                }

                this.noteStep = (this.noteStep + 1) % 16;
            }

            // Sound Effects (SFX)
            playHitSFX(isCorrect) {
                if (this.sfxMuted) return;
                this.init();
                const t = this.ctx.currentTime;
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();

                if (isCorrect) {
                    // High Pitch Success Blip
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(587.33, t); // D5
                    osc.frequency.exponentialRampToValueAtTime(880, t + 0.1); // A5
                    gain.gain.setValueAtTime(0.15, t);
                    gain.gain.linearRampToValueAtTime(0.01, t + 0.12);
                } else {
                    // Buzz Error Sound
                    osc.type = 'sawtooth';
                    osc.frequency.setValueAtTime(150, t);
                    osc.frequency.linearRampToValueAtTime(80, t + 0.15);
                    gain.gain.setValueAtTime(0.2, t);
                    gain.gain.linearRampToValueAtTime(0.01, t + 0.15);
                }

                osc.connect(gain);
                gain.connect(this.ctx.destination);
                osc.start(t);
                osc.stop(t + 0.15);
            }

            playGameOverSFX() {
                if (this.sfxMuted) return;
                this.init();
                const t = this.ctx.currentTime;
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();

                osc.type = 'triangle';
                osc.frequency.setValueAtTime(400, t);
                osc.frequency.exponentialRampToValueAtTime(100, t + 0.5);
                gain.gain.setValueAtTime(0.2, t);
                gain.gain.linearRampToValueAtTime(0.01, t + 0.5);

                osc.connect(gain);
                gain.connect(this.ctx.destination);
                osc.start(t);
                osc.stop(t + 0.5);
            }
        }

        // Instantiate AudioEngine globally before particles and visualizer start referencing it
        const audio = new AudioEngine();

        // ==========================================
        // BACKGROUND PARTICLES & AUDIO VISUALIZER
        // ==========================================
        const bgCanvas = document.getElementById('bgCanvas');
        const bgCtx = bgCanvas.getContext('2d');
        let bgParticles = [];

        function resizeCanvas() {
            bgCanvas.width = window.innerWidth;
            bgCanvas.height = window.innerHeight;
        }
        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();

        class Particle {
            constructor() {
                this.reset();
            }
            reset() {
                this.x = Math.random() * bgCanvas.width;
                this.y = Math.random() * bgCanvas.height;
                this.size = Math.random() * 2 + 1;
                this.speedY = Math.random() * -1 - 0.2;
                this.alpha = Math.random() * 0.5 + 0.2;
            }
            update() {
                this.y += this.speedY;
                if (this.y < 0) this.reset();
            }
            draw() {
                bgCtx.fillStyle = `rgba(0, 240, 255, ${this.alpha})`;
                bgCtx.beginPath();
                bgCtx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
                bgCtx.fill();
            }
        }

        for (let i = 0; i < 40; i++) bgPartic
