                    <button data-diff="normal" class="diff-btn px-4 py-1.5 rounded-lg border border-yellow-500/50 text-xs font-mono text-yellow-300 hover:bg-yellow-500/20 bg-yellow-500/20 transition-all">NORMAL</button>
                    <button data-diff="hard" class="diff-btn px-4 py-1.5 rounded-lg border border-red-500/50 text-xs font-mono text-red-300 hover:bg-red-500/20 transition-all">EKSTREM</button>
                </div>

                <button id="btnStart" class="px-8 py-3 rounded-xl bg-gradient-to-r from-cyan-500 via-teal-400 to-pink-500 text-black font-orbitron font-black text-lg tracking-wider hover:opacity-90 transition-all transform hover:scale-105 active:scale-95 shadow-xl shadow-cyan-500/30">
